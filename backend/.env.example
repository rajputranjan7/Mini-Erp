# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Locally via docker-compose this matches
# the credentials in docker-compose.yml. On Render/Railway/Neon/Supabase,
# copy the connection string they give you.
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/mini_erp?schema=public"

# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# The deployed frontend URL (comma-not-supported; single origin).
CORS_ORIGIN="http://localhost:5173"
