{
  "info": {
    "name": "Mini ERP + CRM API",
    "description": "Full Stack Developer Case Study - Mini ERP/CRM Operations Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "challanId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@minierp.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"sales@minierp.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Warehouse)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"warehouse@minierp.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Accounts)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"accounts@minierp.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        { "name": "Get current user", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } }
      ]
    },
    {
      "name": "Customers",
      "item": [
        { "name": "List customers", "request": { "method": "GET", "url": "{{baseUrl}}/customers?page=1&pageSize=20" } },
        { "name": "Search customers", "request": { "method": "GET", "url": "{{baseUrl}}/customers?search=Suresh" } },
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["const data = pm.response.json();", "if (data.id) pm.collectionVariables.set('customerId', data.id);"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"mobile\": \"9998887770\",\n  \"email\": \"test@example.com\",\n  \"businessName\": \"Test Traders\",\n  \"customerType\": \"WHOLESALE\",\n  \"status\": \"LEAD\",\n  \"address\": \"MG Road, Ahmedabad\"\n}"
            },
            "url": "{{baseUrl}}/customers"
          }
        },
        { "name": "Get customer by ID", "request": { "method": "GET", "url": "{{baseUrl}}/customers/{{customerId}}" } },
        {
          "name": "Update customer",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" },
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        {
          "name": "Add follow-up note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Called customer, will place order next week\",\n  \"followUpDate\": \"2026-08-20\"\n}" },
            "url": "{{baseUrl}}/customers/{{customerId}}/follow-ups"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        { "name": "List products", "request": { "method": "GET", "url": "{{baseUrl}}/products?page=1&pageSize=20" } },
        { "name": "List low-stock products", "request": { "method": "GET", "url": "{{baseUrl}}/products?lowStockOnly=true" } },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["const data = pm.response.json();", "if (data.id) pm.collectionVariables.set('productId', data.id);"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PVC Pipe 2 inch\",\n  \"sku\": \"PVC-PIPE-02\",\n  \"category\": \"Plumbing\",\n  \"unitPrice\": 180,\n  \"currentStock\": 100,\n  \"minStockQty\": 20,\n  \"location\": \"Warehouse A - Rack 4\"\n}"
            },
            "url": "{{baseUrl}}/products"
          }
        },
        { "name": "Get product by ID", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" } },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"unitPrice\": 190\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        { "name": "Get stock movement log", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}/stock-movements" } },
        {
          "name": "Record stock IN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 50,\n  \"movementType\": \"IN\",\n  \"reason\": \"New shipment received\"\n}" },
            "url": "{{baseUrl}}/products/{{productId}}/stock-movements"
          }
        },
        {
          "name": "Record stock OUT (insufficient stock example)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 999999,\n  \"movementType\": \"OUT\",\n  \"reason\": \"Damaged in warehouse\"\n}" },
            "url": "{{baseUrl}}/products/{{productId}}/stock-movements"
          }
        }
      ]
    },
    {
      "name": "Sales Challans",
      "item": [
        { "name": "List challans", "request": { "method": "GET", "url": "{{baseUrl}}/challans?page=1&pageSize=20" } },
        { "name": "List draft challans", "request": { "method": "GET", "url": "{{baseUrl}}/challans?status=DRAFT" } },
        {
          "name": "Create challan (draft)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["const data = pm.response.json();", "if (data.id) pm.collectionVariables.set('challanId', data.id);"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 5 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/challans"
          }
        },
        { "name": "Get challan by ID", "request": { "method": "GET", "url": "{{baseUrl}}/challans/{{challanId}}" } },
        {
          "name": "Update draft challan",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 8 }\n  ]\n}" },
            "url": "{{baseUrl}}/challans/{{challanId}}"
          }
        },
        { "name": "Confirm challan (deducts stock)", "request": { "method": "POST", "url": "{{baseUrl}}/challans/{{challanId}}/confirm" } },
        { "name": "Cancel challan (restocks if confirmed)", "request": { "method": "POST", "url": "{{baseUrl}}/challans/{{challanId}}/cancel" } }
      ]
    },
    {
      "name": "Health",
      "item": [{ "name": "Health check", "request": { "method": "GET", "url": "http://localhost:4000/health" } }]
    }
  ]
}
